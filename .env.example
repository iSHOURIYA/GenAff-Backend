# ─── Application ────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# ─── URLs ────────────────────────────────────────────────────────────────────
FRONTEND_URL=https://genaff.shauryacodes.xyz
BACKEND_URL=https://genaff-api.shauryacodes.xyz

# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://genaff:genaff_pass@localhost:5432/genaff_db?schema=public

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── JWT ─────────────────────────────────────────────────────────────────────
JWT_SECRET=
JWT_EXPIRES_IN=7d

# ─── Provider API Keys ───────────────────────────────────────────────────────
OPENAI_API_KEY=sk-your-openai-key-here
DEEPSEEK_API_KEY=your-deepseek-key-here
GEMINI_API_KEY=your-gemini-api-key-here

# ─── Payment (Razorpay) ──────────────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# ─── Currency & Billing ──────────────────────────────────────────────────────
# 1 USD = X INR (update regularly or use a live exchange rate API)
EXCHANGE_RATE_USD_TO_INR=83.5

# Free units given to new users on signup (number of requests OR token-equivalent)
DEFAULT_FREE_UNITS=100

# Unit = "request" | "token"  (deduction mode for free_units)
FREE_UNIT_MODE=request

# Admin seed credentials (used by prisma/seed.ts only)
ADMIN_SEED_EMAIL=admin@genaff.local
ADMIN_SEED_PASSWORD=Admin@123456
