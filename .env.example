# ─────────────────────────────────────────
# GenAff Backend – Environment Variables
# Copy this file to .env and fill in values
# ─────────────────────────────────────────
#
# ══ DOMAIN SWAP GUIDE ══
# If you ever lose your domain, ONLY change these 4 lines:
#   FRONTEND_URL   = https://genaff.yourdomain.com
#   API_DOMAIN     = genaff-api.yourdomain.com
#   SUPPORT_EMAIL  = support@genaff.yourdomain.com
#   FROM_EMAIL     = noreply@genaff.yourdomain.com
# Then run: ./deploy.sh
# ─────────────────────────────────────────

# PostgreSQL connection string
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/genaff

# JWT secret (use a long random string in production)
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production

# JWT expiry (e.g. 7d, 24h, 1h)
JWT_EXPIRES_IN=7d

# Server port
PORT=3000

# Node environment: development | production
NODE_ENV=development

# ═══════════════════════════════════════
# CRITICAL: Domains (only change these 4 on a swap)
# ═══════════════════════════════════════
FRONTEND_URL=https://genaff.yourdomain.com
API_DOMAIN=genaff-api.yourdomain.com
SUPPORT_EMAIL=support@genaff.yourdomain.com
FROM_EMAIL=noreply@genaff.yourdomain.com

# ─────────────────────────────────────────
# Razorpay (production payments)
# Dashboard: https://dashboard.razorpay.com/app/keys
# ─────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_live_...
RAZORPAY_KEY_SECRET=your_razorpay_secret

# ─────────────────────────────────────────
# AI Provider API Keys
# ─────────────────────────────────────────
OPENAI_API_KEY=sk-...
DEEPSEEK_API_KEY=sk-...
GEMINI_API_KEY=AIza...
NVIDIA_API_KEY=nvapi-...

# ─────────────────────────────────────────
# Rate limiting (requests per minute per API key)
# ─────────────────────────────────────────
RATE_LIMIT_RPM=20

# ─────────────────────────────────────────
# Minimum top-up amount in INR
# ─────────────────────────────────────────
MIN_TOPUP_INR=10

# ─────────────────────────────────────────
# Email (Resend)
# Get API key from: https://resend.com/api-keys
# ─────────────────────────────────────────
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=noreply@genaff.yourdomain.com

# OTP expiry in minutes (default: 15)
OTP_EXPIRY_MINUTES=15

# ─────────────────────────────────────────
# Billing PDF Branding
# ─────────────────────────────────────────
BILLING_COMPANY_NAME=GenAff
BILLING_COMPANY_WEBSITE=https://genaff.yourdomain.com
BILLING_SUPPORT_EMAIL=support@genaff.yourdomain.com
BILLING_SIGNATORY_NAME=Your Name

# ─────────────────────────────────────────
# Health Check (passive-first, optimised defaults)
#
# HEALTH_CHECK_ENABLED=false         → disables active probes (zero API cost)
# HEALTH_CHECK_INTERVAL_MS=21600000  → 6 hours
# HEALTH_CHECK_MAX_PROBES_PER_CYCLE=4→ canaries only
# ─────────────────────────────────────────
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_INTERVAL_MS=21600000
HEALTH_CHECK_TIMEOUT_MS=8000
HEALTH_CHECK_MAX_PROBES_PER_CYCLE=4

# Optional: force which models to serve (bypasses health system)
# LIVE_MODELS_OVERRIDE=gemini-2.5-flash,gpt-4o-mini,deepseek-chat
