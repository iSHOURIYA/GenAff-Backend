# ─────────────────────────────────────────
# GenAff Backend – Environment Variables
# Copy this file to .env and fill in values
# ─────────────────────────────────────────

# PostgreSQL connection string
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/genaff

# JWT secret (use a long random string in production)
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production

# JWT expiry (e.g. 7d, 24h, 1h)
JWT_EXPIRES_IN=7d

# Server port
PORT=3000

# Node environment: development | production
NODE_ENV=development

# ─────────────────────────────────────────
# Razorpay (production payments)
# Dashboard: https://dashboard.razorpay.com/app/keys
# ─────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_live_...
RAZORPAY_KEY_SECRET=your_razorpay_secret

# ─────────────────────────────────────────
# AI Provider API Keys
# ─────────────────────────────────────────
OPENAI_API_KEY=sk-...
DEEPSEEK_API_KEY=sk-...
GEMINI_API_KEY=AIza...

# ─────────────────────────────────────────
# CORS – your frontend domain
# ─────────────────────────────────────────
FRONTEND_URL=https://genaff.shauryacodes.xyz

# ─────────────────────────────────────────
# Rate limiting (requests per minute per API key)
# ─────────────────────────────────────────
RATE_LIMIT_RPM=20

# ─────────────────────────────────────────
# Minimum top-up amount in INR
# ─────────────────────────────────────────
MIN_TOPUP_INR=10
