// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

model User {
  id             String   @id @default(uuid())
  email          String   @unique
  password_hash  String
  created_at     DateTime @default(now())
  free_units     Int      @default(10)
  email_verified Boolean  @default(false)
  role           UserRole @default(USER)
  is_suspended   Boolean  @default(false)

  api_keys              ApiKey[]
  wallet                Wallet?
  usages                Usage[]
  top_ups               TopUp[]
  pending_verifications PendingVerification[]
  pending_password_resets PendingPasswordReset[]
  playground_sessions   PlaygroundSession[]
  model_restrictions    UserModelRestriction[]

  @@map("users")
}

model PendingVerification {
  id         String   @id @default(uuid())
  user_id    String
  otp        String   // 6-digit code
  token      String   @unique // uuid for magic link
  expires_at DateTime
  used       Boolean  @default(false)
  created_at DateTime @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("pending_verifications")
}

model PendingPasswordReset {
  id         String   @id @default(uuid())
  user_id    String
  otp        String   // 6-digit code
  token      String   @unique // uuid for magic link
  expires_at DateTime
  used       Boolean  @default(false)
  created_at DateTime @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@map("pending_password_resets")
}

model ApiKey {
  id         String   @id @default(uuid())
  key_hash   String   @unique
  key_prefix String   // Store "sk_genaff_XXXXX" first 20 chars for display
  user_id    String
  created_at DateTime @default(now())
  active     Boolean  @default(true)
  is_playground         Boolean   @default(false)
  expires_at            DateTime?
  playground_session_id String?   @unique

  user   User    @relation(fields: [user_id], references: [id], onDelete: Cascade)
  usages Usage[]
  playground_session PlaygroundSession? @relation(fields: [playground_session_id], references: [id], onDelete: SetNull)
  playground_messages PlaygroundMessage[]

  @@index([is_playground, expires_at])
  @@map("api_keys")
}

model PlaygroundSession {
  id         String   @id @default(uuid())
  user_id    String
  title      String   @default("Untitled Chat")
  created_at DateTime @default(now())
  expires_at DateTime

  user     User               @relation(fields: [user_id], references: [id], onDelete: Cascade)
  api_key  ApiKey?
  messages PlaygroundMessage[]

  @@index([user_id, expires_at])
  @@map("playground_sessions")
}

model PlaygroundMessage {
  id         String   @id @default(uuid())
  session_id String
  api_key_id String
  role       String
  content    String
  provider   String?
  model      String?
  tokens_used Int     @default(0)
  cost_inr   Decimal  @default(0) @db.Decimal(10, 6)
  created_at DateTime @default(now())

  session PlaygroundSession @relation(fields: [session_id], references: [id], onDelete: Cascade)
  api_key ApiKey           @relation(fields: [api_key_id], references: [id], onDelete: Cascade)

  @@index([session_id, created_at])
  @@map("playground_messages")
}

model Wallet {
  id          String   @id @default(uuid())
  user_id     String   @unique
  balance_inr Decimal  @default(0) @db.Decimal(10, 4)
  updated_at  DateTime @updatedAt

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("wallets")
}

model Usage {
  id          String   @id @default(uuid())
  user_id     String
  api_key_id  String
  provider    String   // openai | deepseek | gemini
  model       String
  tokens_used Int
  cost_inr    Decimal  @db.Decimal(10, 6)
  created_at  DateTime @default(now())

  user    User   @relation(fields: [user_id], references: [id], onDelete: Cascade)
  api_key ApiKey @relation(fields: [api_key_id], references: [id], onDelete: Cascade)

  @@map("usages")
}

model TopUp {
  id                  String   @id @default(uuid())
  user_id             String
  amount              Decimal  @db.Decimal(10, 2)
  status              String   @default("pending") // pending | completed | failed
  razorpay_order_id   String?  @unique
  razorpay_payment_id String?
  created_at          DateTime @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("top_ups")
}

model UserModelRestriction {
  id         String   @id @default(uuid())
  user_id    String
  model      String
  created_at DateTime @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, model])
  @@index([user_id])
  @@map("user_model_restrictions")
}
